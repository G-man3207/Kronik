[Unit]
Description=Kronik: every change verified against production traffic
# Wants=, not Requires=: when the pin fails, the daemon still serves Wasm
# actors, and foreign actors report FOREIGN_UNAVAILABLE with the reason.
Wants=kronik-userns.service
After=network-online.target kronik-userns.service
Wants=network-online.target

[Service]
Type=simple
User=kronik
Group=kronik
ExecStart=@KRONIK@ serve --rootless --config @CONFIG@@KEY_ARGUMENT@
# Also after a crash or SIGKILL; "-": never blocks a restart
# (docs/design/m7-foreign.md §5).
ExecStopPost=-@KRONIK@ foreign cleanup --config @CONFIG@
# The master key stays root-only on disk; systemd hands it to the daemon.
@KEY_CREDENTIAL@
# Ports 80 and 443 only, until the daemon enters its namespace (ADR 0060).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# The sandboxes' cgroups live below the unit's own, in a private cgroup
# namespace (ADR 0061). Not DelegateSubgroup=: with it the namespace is rooted
# at the subgroup, which has no controllers. `serve --init` leaves
# ProtectControlGroups=private out on systemd before 257, which does not have
# it; the daemon then works without the namespace.
Delegate=yes
ProtectControlGroups=private
UMask=0007
Restart=on-failure
RestartSec=2s
LimitNOFILE=65536
# No core dumps: the process holds the master key, secrets and unsealed
# subject data.
LimitCORE=0
# /run/kronik holds the API socket. The data directory (server.data_dir;
# `serve --init` writes its path here) is created kronik:kronik 0700 by
# `serve --init`. Not StateDirectory=: systemd chowns that whole tree to
# User= when the top's owner differs, which would hand foreign actors' data,
# owned by kronik's range, to kronik (ADR 0062).
RuntimeDirectory=kronik
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
ReadWritePaths=/var/lib/kronik
# /var/log/kronik is writable under ProtectSystem=strict for the default
# audit sink, file:///var/log/kronik/audit/ (M28). Its lines name tokens and
# callers; rotating them is the operator's.
LogsDirectory=kronik
LogsDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallErrorNumber=EPERM
SystemCallFilter=~@clock @cpu-emulation @module @obsolete @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
