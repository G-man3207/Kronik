+/// Spike B experiment: the same turn on a fresh instance each time (what
+/// Kronik does) versus repeated calls on one instance (what I3 forbids).
+pub async fn reuse(bytes: &[u8], iterations: u32, msg_name: &str) -> wasmtime::Result<()> {
+    let engine = engine::build_engine()?;
+    let component = wasmtime::component::Component::new(&engine, bytes)?;
+    let runner = Runner::new(&engine, &component)?;
+    let spec: TurnSpec = TurnOpts::default_spec();
+    let input = msg(msg_name, "");
+    for _ in 0..50 {
+        runner.handle(&spec, &input).await?;
+    }
+    let mut fresh = Vec::with_capacity(iterations as usize);
+    let mut fresh_fuel = 0;
+    for _ in 0..iterations {
+        let t = Instant::now();
+        let r = runner.handle(&spec, &input).await?;
+        fresh.push(t.elapsed());
+        fresh_fuel = r.fuel_used;
+    }
+    let calls = runner.handle_reuse(&spec, &input, iterations + 1).await?;
+    let first = calls[0];
+    let later: Vec<Duration> = calls[1..].iter().map(|c| c.1).collect();
+    let later_fuel: Vec<u64> = calls[1..].iter().map(|c| c.0).collect();
+    println!("[{msg_name}] fresh instance per turn: fuel {fresh_fuel}, whole turn {}", fmt(&stats(fresh)));
+    println!("[{msg_name}] one instance, call 1:     fuel {}, {:?}", first.0, first.1);
+    println!(
+        "[{msg_name}] one instance, calls 2..:   fuel {}..{}, call {}",
+        later_fuel.iter().min().unwrap_or(&0),
+        later_fuel.iter().max().unwrap_or(&0),
+        fmt(&stats(later))
+    );
+    Ok(())
+}
