+    /// Spike B experiment: calls `handle` `calls` times on ONE instance, to
+    /// see how much of a turn is per-instance work. Kronik never does this
+    /// (I3); returns fuel and wall time per call.
+    pub async fn handle_reuse(
+        &self,
+        spec: &TurnSpec,
+        input: &Input,
+        calls: u32,
+    ) -> wasmtime::Result<Vec<(u64, Duration)>> {
+        let mut store = self.store(spec, false, 0)?;
+        store.set_fuel(u64::MAX / 4)?;
+        let actor = self.pre.instantiate_async(&mut store).await?;
+        let mut out = Vec::with_capacity(calls as usize);
+        for _ in 0..calls {
+            let before = store.get_fuel()?;
+            let t = Instant::now();
+            if let Err(e) = actor
+                .kronik_actor_handler()
+                .call_handle(&mut store, input)
+                .await?
+            {
+                wasmtime::bail!("handler error: {e:?}");
+            }
+            out.push((before - store.get_fuel()?, t.elapsed()));
+        }
+        Ok(out)
+    }
